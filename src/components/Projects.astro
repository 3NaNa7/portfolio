---
import {projects} from '../data/projects';
---


<section id="projects" class="relative overflow-hidden w-full bg-paper py-8 md:py-16 border-t border-ink/10">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Header -->
    <div class="mb-20 text-left">
      <span class="font-sans text-xs uppercase tracking-widest font-bold text-teal block mb-3">
        Along the Way
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl font-bold text-ink mb-4">
        Projects
      </h2>
      <p class="font-sans text-base sm:text-lg text-ink/70 max-w-2xl leading-relaxed">
        Mobile apps, roughly in the order I built them — each one a step further than the last.
      </p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative w-full pl-8 md:pl-0">

      <!-- Vertical Trail Line -->
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-[2px] -translate-x-1/2 pointer-events-none z-0 select-none opacity-20 bg-trail"></div>

      <!-- Projects Grid/List -->
      <div class="flex flex-col gap-16 md:gap-28 relative z-10">
        {projects.map((project, index) => {


          return (
            <div class="project-card relative w-full flex flex-col md:flex-row gap-8 md:gap-12 items-center">

              <!-- Timeline Dot Marker -->
              <div class="project-dot absolute top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-coral border-4 border-paper z-20 shadow-sm"></div>

              <!-- Visual Phone Mockup / Screenshot window -->
              <div class="phone-container flex-shrink-0 flex items-center justify-center">
                { (
                  /* Normal/Flagship/Paused style: Full frame, notch bezel */
                  <div class="relative w-[200px] h-[400px] md:w-[180px] md:h-[360px] rounded-[2rem] p-2 pb-3 pt-6 flex flex-col justify-between shadow-xl phone-frame bg-ink">
                    {/* Notch Bezel */}
                    <div class="absolute top-2 left-1/2 -translate-x-1/2 w-14 h-3.5 bg-ink rounded-full z-30"></div>

                    {/* Screen Window */}
                    <div class="relative w-full h-full rounded-[1.5rem] overflow-hidden bg-paper">
                      <img
                        src={project.screenshot}
                        alt={`${project.name} screenshot`}
                        class="w-full h-full object-cover"
                        onload="this.style.display='block'; this.nextElementSibling.style.display='none';"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      <div class="hidden absolute inset-0 bg-teal/10 text-ink/50 font-sans text-[11px] flex-col items-center justify-center p-3 text-center leading-normal">
                        <span>Add screenshot to</span>
                        <code class="text-[9px] bg-ink/5 px-1 py-0.5 rounded mt-1 font-mono break-all">
                          public/projects/{project.slug}/1.{project.slug === 'dialogi' ? 'jpg' : 'png'}
                        </code>
                      </div>
                      {/* Screen Glare Overlay */}
                      <div class="absolute inset-0 pointer-events-none bg-gradient-to-tr from-transparent via-white/5 to-white/15 mix-blend-overlay z-20"></div>
                    </div>
                  </div>
                )}
              </div>

              <!-- Text Panel -->
              <div class="text-panel flex-1 flex flex-col justify-center max-w-lg">
                <div class="flex items-center gap-3 mb-2 flex-wrap">
                  <h3 class="font-heading text-2xl font-bold text-ink leading-none">
                    {project.name}
                  </h3>
                </div>

                <p class="font-sans italic text-sm text-ink/70 mb-3 leading-relaxed">
                  {project.tagline}
                </p>

                <p class="font-sans text-sm text-ink/90 mb-5 leading-relaxed">
                  {project.description}
                </p>

                {/* Tech Chips */}
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.tech.map((t) => (
                    <span class="font-sans text-[11px] font-semibold px-2.5 py-0.5 bg-teal/10 text-teal rounded-full whitespace-nowrap">
                      {t}
                    </span>
                  ))}
                </div>

                {/* Link Row */}
                <div class="flex items-center gap-4">
                  {project.repoPrivate ? (
                    <span class="font-sans text-xs text-ink/40 select-none flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                      </svg>
                      Private repo
                    </span>
                  ) : (
                    <a
                      href={project.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 font-sans text-xs font-bold text-teal hover:text-teal/80 hover:underline underline-offset-4 transition-all duration-200"
                    >
                      View on GitHub
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>

            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  /* repeating linear gradient to echo the dashed path */
  .bg-trail {
    background-image: repeating-linear-gradient(
      to bottom,
      var(--color-ink) 0,
      var(--color-ink) 8px,
      transparent 8px,
      transparent 16px
    );
  }

  /* Mobile positioning of dots */
  .project-dot {
    left: -2.5rem; /* center on the 16px left trail line */
    transform: translate(-1px, -50%);
  }

  /* Desktop Staggering & Alternating */
  @media (min-width: 768px) {
    /* 1st and 3rd card on Left */
    .project-card:nth-child(odd) {
      align-self: flex-start;
      width: calc(50% - 2rem);
      flex-direction: row-reverse;
      text-align: right;
    }
    .project-card:nth-child(odd) .text-panel {
      align-items: flex-end;
    }
    .project-card:nth-child(odd) .text-panel > div {
      justify-content: flex-end;
    }
    .project-card:nth-child(odd) .project-dot {
      left: auto;
      right: -2.5rem;
      transform: translate(1px, -50%);
    }

    /* 2nd and 4th card on Right */
    .project-card:nth-child(even) {
      align-self: flex-end;
      width: calc(50% - 2rem);
      flex-direction: row;
      text-align: left;
    }
    .project-card:nth-child(even) .text-panel {
      align-items: flex-start;
    }
    .project-card:nth-child(even) .project-dot {
      left: -2.5rem;
      transform: translate(-1px, -50%);
    }
  }

  /* Interactive hover & scroll-active animations (respects prefers-reduced-motion) */
  @media (prefers-reduced-motion: no-preference) {
    .project-card {
      transition: opacity 0.45s ease;
    }
    .project-card:not(.active):not(:hover) {
      opacity: 0.8;
    }
    .project-card.active,
    .project-card:hover {
      opacity: 1;
    }

    .project-dot {
      opacity: 0.6;
      scale: 1;
      transition: scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.45s ease, opacity 0.45s ease;
    }
    .project-card:hover .project-dot,
    .project-card.active .project-dot,
    .project-card.mobile-active .project-dot {
      opacity: 1;
      scale: 1.45;
      box-shadow: 0 0 0 6px rgba(224, 118, 90, 0.35), 0 0 18px var(--color-coral);
    }

    .phone-frame {
      opacity: 0.85;
      transform: scale(1);
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.45s ease, opacity 0.45s ease;
    }
    .project-card:hover .phone-frame,
    .project-card.active .phone-frame,
    .project-card.mobile-active .phone-frame {
      opacity: 1;
      transform: scale(1.05);
      box-shadow: 0 25px 35px -5px rgba(0, 0, 0, 0.22), 0 12px 16px -6px rgba(0, 0, 0, 0.15);
    }

    .text-panel {
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .project-card:hover .text-panel,
    .project-card.active .text-panel {
      transform: translateY(-2px);
    }
  }
</style>

<script>
  // Add active class to project cards ONLY when they hit the central focal strip of the screen
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
        entry.target.classList.add('mobile-active');
      } else {
        entry.target.classList.remove('active');
        entry.target.classList.remove('mobile-active');
      }
    });
  }, {
    // Tight 16% center focal band (42% top margin, 42% bottom margin)
    // Ensures only ONE project is active at a time as you scroll
    rootMargin: '-42% 0px -42% 0px',
    threshold: 0.1
  });

  // Observe all project cards across desktop and mobile
  document.querySelectorAll('.project-card').forEach(card => {
    observer.observe(card);
  });
</script>
