---
// NOTE TO USER: Personalize the bio paragraph below further with details of your own experience, interests, or background.
import SkillsGrid from './SkillsGrid.jsx';
---

<section id="about" class="relative overflow-hidden w-full bg-paper py-16 sm:py-24 md:py-32">
  <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="absolute top-0 left-0 w-full h-24 sm:h-32" aria-hidden="true">
  <path d="M0,50 Q360,15 720,45 T1440,30 L1440,0 L0,0 Z" fill="#A8CFC9" opacity="0.25" />
</svg>
  <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row gap-12 md:gap-16">

    <!-- Left side: Bio text -->
    <div class="flex-1 space-y-6">
      <!-- Illustrated Avatar, increase w,h,md values to increase size of avatar -->
      <div class="relative w-52 h-52 md:w-64 md:h-64 select-none pointer-events-none">
        <!-- Dashed Ring echoing Hero dashed path -->
        <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 100 100">
          <circle
            cx="50"
            cy="50"
            r="47"
            fill="none"
            stroke="var(--color-ink)"
            stroke-width="2"
            stroke-dasharray="5 5"
            opacity="0.25"
          />
        </svg>
        <!-- Circular Backdrop -->
        <div
          class="absolute bg-amber/20 rounded-full flex items-center justify-center overflow-hidden"
          style="inset: 4.5%;"
        >
          <img
            src="/avatar.svg"
            alt="Illustrated portrait of Samuelson Boadu-Acheampong"
            class="w-full h-full object-contain"
          />
        </div>
      </div>

      <h2 class="font-heading text-3xl sm:text-4xl text-ink">
        A bit about me
      </h2>
      <p class="font-body text-base sm:text-lg text-ink/80 leading-relaxed">
        I like figuring things out. How things work, why they work, and occasionally why they don’t.
Software turned out to be a pretty good place for that curiosity to live.
These days, that means building across web and mobile, exploring AI/ML, and working on research when a problem gets interesting enough.
Some of my interesting stuff are
        <a
          href="#projects"
          aria-label="Jump to projects"
          class="below-cta"
          onclick="event.preventDefault(); document.getElementById('projects').scrollIntoView({behavior:'smooth'})"
        >BEL<svg
            class="below-cta__o"
            viewBox="0 0 28 28"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          ><circle cx="14" cy="14" r="12" stroke="var(--color-teal)" stroke-width="2.2"/><polyline class="below-cta__chevron" points="9,11 14,17 19,11" stroke="var(--color-teal)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>W.</a>
      </p>
      <p class="font-body text-sm italic text-coral font-medium">
        I tend to turn “I wonder if…” into “I built it.”
      </p>
    </div>

    <!-- Right side: Skills grid -->
    <div class="flex-1 skills-reveal-wrapper">
      <h2 class="font-heading text-3xl sm:text-4xl text-ink mb-6">What I work with</h2>
      <SkillsGrid client:load />
    </div>

  </div>
</section>

<style>
  /* CSS-based scroll reveal that executes instantly without waiting for React hydration */
  .skills-reveal-wrapper {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: opacity, transform;
  }

  .skills-reveal-wrapper.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── BELOW CTA link ── */
  .below-cta {
    font-family: var(--font-heading, serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.6em;           /* ~1.6× the surrounding <p> text */
    line-height: 1;             /* don't inflate paragraph line-height */
    color: var(--color-teal);
    display: inline-flex;
    align-items: center;
    gap: 0;
    margin-inline: 0.25em;
    white-space: nowrap;
    text-decoration: none;
    vertical-align: middle;
    transition: opacity 0.2s ease;
  }

  .below-cta:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* SVG "O" — sized to match the cap-height of the surrounding letters */
  .below-cta__o {
    width: 0.72em;
    height: 0.72em;
    display: inline-block;
    vertical-align: middle;
    /* small horizontal spacing so it doesn't crowd BEL / W */
    margin-inline: 0.04em;
    overflow: visible;
  }

  /* Hover: nudge chevron downward */
  .below-cta__chevron {
    transform-origin: 14px 14px;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .below-cta:hover .below-cta__chevron,
  .below-cta:focus-visible .below-cta__chevron {
    transform: translateY(3px);
  }

  /* Reduced-motion: disable translate, keep color */
  @media (prefers-reduced-motion: reduce) {
    .below-cta__chevron {
      transition: none;
    }
    .below-cta:hover .below-cta__chevron,
    .below-cta:focus-visible .below-cta__chevron {
      transform: none;
    }
  }
</style>

<script>
  // Vanilla JS observer to trigger scroll reveal instantly
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });

  const wrapper = document.querySelector('.skills-reveal-wrapper');
  if (wrapper) {
    observer.observe(wrapper);

    // Fallback: If user scrolls extremely fast or JS is slow,
    // ensure it shows up after a timeout just in case.
    setTimeout(() => {
      wrapper.classList.add('is-revealed');
    }, 1500);
  }
</script>

